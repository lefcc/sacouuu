# Configurações da API Sacou
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.

# Conexão com o MySQL (db_sacou)
# Formato: mysql+pymysql://USUARIO:SENHA@HOST:PORTA/DB
DATABASE_URL=mysql+pymysql://root:senha@localhost:3306/db_sacou

# Segredos / Tokens
JWT_SECRET=troque-este-segredo-por-um-valor-forte
JWT_ALGORITHM=HS256
TOKEN_EXPIRA_MINUTOS=480

# Servidor
API_HOST=0.0.0.0
API_PORT=8000

# URL pública da API (usada para montar links de mídia)
API_BASE_URL=http://localhost:8000

# Origens liberadas no CORS (separadas por vírgula). Para demo via rede,
# adicione a origem do IP usado (ex.: http://192.168.0.10:5173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# SMTP (recuperação de senha)
# Senha de app do Gmail: ative a Verificação em 2 etapas e crie uma "Senha de app"
# em https://myaccount.google.com/apppasswords (a senha normal não funciona).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=sacoueducacao@gmail.com
EMAIL_PASSWORD=coloque_a_senha_de_app_aqui
EMAIL_USE_TLS=true
EMAIL_RECIPIENT=sacoueducacao@gmail.com
FRONTEND_URL=http://localhost:5173
